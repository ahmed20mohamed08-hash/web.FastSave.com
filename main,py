# 2. فحص الرابط لأي منصة
@app.post("/api/check")
async def check_url(data: dict):
    url = data.get("url")
    if not url:
        raise HTTPException(status_code=400, detail="الرابط مطلوب")
    try:
        ydl_opts = {'quiet': True, 'no_warnings': True, 'skip_download': True}
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=False)
            title = info.get('title', 'محتوى بدون عنوان')
            return {
                "success": True,
                "title": title,
                "formats": [
                    {"id": "best", "label": "🎬 أعلى جودة متاحة (MP4)"},
                    {"id": "audio", "label": "🎵 صوت فقط (MP3 - تحويل محلي آمن)"}
                ]
            }
    except Exception as e:
        return JSONResponse(status_code=500, content={"success": False, "error": "فشل فحص الرابط، تأكد من صحته أو توفر المحتوى."})

# 3. التحميل الذكي لكل المنصات (بما فيها تيك توك)
@app.get("/api/download")
async def download_media(url: str, format: str = "best"):
    if not url:
        raise HTTPException(status_code=400, detail="الرابط مطلوب")

    file_id = str(int(time.time() * 1000))
    out_template = os.path.join(DOWNLOADS_DIR, f"{file_id}.%(ext)s")

    ydl_opts = {'outtmpl': out_template, 'quiet': True, 'no_warnings': True, 'format': 'best'}

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            downloaded_file = ydl.prepare_filename(info)

        target_file = downloaded_file
        media_type = "video/mp4"
        download_name = "video.mp4"

        # إذا طلب المستخدم صوت، يتم تنزيل الفيديو أولاً ثم تحويله بواسطة FFmpeg لتفادي حجب روابط الصوت في تيك توك
        if format == "audio":
            base_name = os.path.splitext(downloaded_file)[0]
            mp3_file = f"{base_name}.mp3"
            
            subprocess.run([
                'ffmpeg', '-y', '-i', downloaded_file, 
                '-vn', '-acodec', 'libmp3lame', '-ab', '192k', mp3_file
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            if os.path.exists(downloaded_file):
                os.remove(downloaded_file)

            target_file = mp3_file
            media_type = "audio/mpeg"
            download_name = "audio.mp3"

        # تنظيف وبث الملف للمستخدم ثم مسحه من السيرفر فوراً
        def iterfile():
            try:
                with open(target_file, mode="rb") as file_like:
                    yield from file_like
            finally:
                if os.path.exists(target_file):
                    os.remove(target_file)

        return StreamingResponse(
            iterfile(),
            media_type=media_type,
            headers={"Content-Disposition": f'attachment; filename="{download_name}"'}
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"حدث خطأ أثناء التنزيل: {str(e)}")

# 4. تحويل فيديو محلي إلى صوت
@app.post("/api/convert")
async def convert_local_video(video: UploadFile = File(...)):
    input_path = os.path.join(UPLOADS_DIR, f"{time.time()}_{video.filename}")
    output_path = os.path.splitext(input_path)[0] + ".mp3"

    with open(input_path, "wb") as buffer:
        buffer.write(await video.read())

    try:
        subprocess.run([
            'ffmpeg', '-y', '-i', input_path, 
            '-vn', '-acodec', 'libmp3lame', '-ab', '192k', output_path
        ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def iterfile():
            try:
                with open(output_path, mode="rb") as file_like:
                    yield from file_like
            finally:
                if os.path.exists(input_path):
                    os.remove(input_path)
                if os.path.exists(output_path):
                    os.remove(output_path)

        return StreamingResponse(
            iterfile(),
            media_type="audio/mpeg",
            headers={"Content-Disposition": 'attachment; filename="converted.mp3"'}
        )
    except Exception as e:
        if os.path.exists(input_path):
            os.remove(input_path)
        raise HTTPException(status_code=500, detail="فشل تحويل الملف")

